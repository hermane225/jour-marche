# Configuration API Jour de Marché
# Copiez ce fichier en .env et configurez vos variables

# URL de l'API backend
VITE_API_URL=https://jour-marche-api.onrender.com

# Mode de l'application (development, staging, production)
VITE_APP_MODE=development

# Activer/Désactiver le mode mock (utiliser les données locales)
VITE_USE_MOCK_DATA=false

# Google OAuth Client ID (obtenir sur https://console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
